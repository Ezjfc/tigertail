# tigertaild configuration — lives at /home/root/tigertail/tigertail.toml on
# the tablet (survives OS updates). Apply changes with:
#   systemctl restart tigertaild
# Every key is optional; CLI flags override these values.

# Input nodes. Default to the detected device profile's.
#pen_device = "/dev/input/event1"
#touch_device = "/dev/input/event2"

# What to forward to the host: the pen as a HID pen digitizer, touch as a
# precision touchpad. Independent of grabbing below.
pen = true
touch = true

# Grab each device away from xochitl (it stops reacting to that input).
# Independent of forwarding: e.g. touch = false + grab_touch = true stops
# accidental page turns while only the pen is forwarded.
grab_pen = true
grab_touch = true
# Deprecated alias that sets both: grab_input = true

# Suppress touch while the pen is down and for palm_grace_ms after pen-up.
palm_rejection = true
#palm_grace_ms = 500

# Host screen orientation relative to the tablet held with buttons at top:
# portrait, landscape-right, landscape-left, inverted.
orientation = "landscape-right"

# How the pen area maps onto the host: fill (stretch), contain (letterbox),
# cover (crop). contain/cover need aspect_ratio or resolution.
fit = "fill"
#aspect_ratio = "16:9"
#resolution = "1920x1080"

# Hover-cursor vs. ink offset correction: off, tilt, tilt-distance.
tilt_correction = "off"
#tilt_correction_gain = 1.0

# USB strings shown to the host while the pen is attached. They name the
# input device ("<manufacturer> <product>") but are gadget-wide, so the
# USB-ethernet adapter is renamed too. Stock values return on exit; Windows
# may keep showing a cached name until the device is forgotten.
#usb_product = "tigertail"
#usb_manufacturer = "reMarkable"
